*
*ZETEX  ZXMN64N03X Spice Model   Last revision 23/1/03
*
* BC 5/1/2004: converted from pspice to spice
*
.SUBCKT ZXM64N03X 3 4 5
*----connections----D-G-S
*
M1 6 2 8 8 MOSMOD
M2 6 2 8 8 MOSMODS
RG 4 2 5
RIN 2 8 200E6
RD 3 6 RDSMOD 0.02
RS 8 5 RDSMOD 0.004 
RL 3 5 35E6
C1 2 8 810E-12
C2 2 3 100E-12 
C3 15 14 1050E-12
C4 16 8 1100E-12
D1 5 3 DMOD1
S1 2 15 13 14 SMOD1a
S2 13 15 13 14 SMOD1b
S3 16 13 8 13 SMOD2a
S4 16 2 8 13 SMOD2b
Egs2 13 8 2 8 1
Eds1 14 8 3 8 1
.MODEL MOSMOD NMOS VTO=2.2 IS=1E-15 KP=15 CBD=512E-12 PB=1 LAMBDA=4.9E-3
.MODEL MOSMODS NMOS VTO=1.8 IS=1E-15 KP=0.1 PB=1
.MODEL DMOD1 D IS=6E-13 RS=0.025 BV=38 IBV=1E-6 TT=21e-9

* .MODEL SMOD1a VSWITCH RON=1e-2 ROFF=1e4  VON=3.2 VOFF=-1.3
.MODEL SMOD1a SW(RON=1e-2 ROFF=1e4  VH=2.25 VT=0.95)

* .MODEL SMOD1b VSWITCH RON=1e-2 ROFF=1e4  VON=-1.3 VOFF=3.2
.MODEL SMOD1b SW(RON=1e-2 ROFF=1e4  VH=-2.25 VT=0.95)

* .MODEL SMOD2a VSWITCH RON=1e2 ROFF=1e4  VON=1.5 VOFF=3.5
.MODEL SMOD2a SW(RON=1e2 ROFF=1e4  VH=-1 VT=2.5)

* .MODEL SMOD2b VSWITCH RON=1e-2 ROFF=1e4  VON=3.5 VOFF=1.5
.MODEL SMOD2b SW(RON=1e-2 ROFF=1e4  VH=1 VT=2.5)

* .MODEL RDSMOD RES (TC1=3E-3 TC2=1.5E-5)
.MODEL RDSMOD R (TC1=3E-3 TC2=1.5E-5)

.ENDS  ZXM64N03X
