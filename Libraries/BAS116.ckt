+  CJO =  1.9002E-12
+  VJ =  1.2722
+  M =  0.35193
+  BV =  113.3
+  IBV =  1.00E+01
+)

.MODEL DHIGH D
+(
+  IS =  0.000393706
+  N =  1.0246
+  RS =  0.05
+)

.MODEL DRECOMB D
+(
+  IS =  2.89544E-13
+  N =  1.961935314
+)

.ENDS BAS116








