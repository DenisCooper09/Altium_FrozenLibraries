*MCR102 MCE 4-30-97
*Ref: Motorola Thyristor Device Data, Q2/95
*30V 1A pkg:TO-92B 1,2,3
.SUBCKT MCR102   1 2 3
*    TERMINALS:  A G K
QP  6 4 1  POUT OFF
QN  4 6 5  NOUT OFF
RF  6 4    6MEG
RR  1 4    4MEG
RGK 6 5    240
RG  2 6    45.8
RK  3 5    0.18
DF  6 4    ZF
DR  1 4    ZR
DGK 6 5    ZGK
.MODEL ZF   D (IS=3.2E-16 IBV=1U BV=30)
.MODEL ZR   D (IS=3.2E-16 IBV=1U BV=30)
.MODEL ZGK  D (IS=3.2E-16 IBV=1U BV=4)
.MODEL POUT PNP (IS=320F BF=1 CJE=335P TF=8.06U)
.MODEL NOUT NPN (IS=320F BF=100 RC=0.72 CJE=1.68N CJC=335P TF=538N)
.ENDS
