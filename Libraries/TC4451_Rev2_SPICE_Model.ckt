R51 51  0 1
G53  3  0 TABLE {V(51,0)} ((-100,100)(0,0)(1,1n))
G54  0  4 TABLE {V(0,51)} ((-100,100)(0,0)(1,1n))
R60 0    60   100MEG  
H67 0    69   V67 1
V67 60   59   0V
C60 561    60   6N
R59 59   2   0.5
L59 59   2   5N
